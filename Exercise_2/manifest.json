{
  "manifest_version": 3,
  "name": "PixelRuler",
  "description": "Measure any distance on the page with a two-click ruler.",
  "version": "1.0.0",
  "minimum_chrome_version": "108",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Measure with PixelRuler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["cursor.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
